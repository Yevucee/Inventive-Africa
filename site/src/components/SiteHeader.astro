---
import { hrefPath } from '../lib/postPaths';
import { SITE_LOGO_ALT, SITE_LOGO_SRC, SITE_TAGLINE } from '../lib/branding';
---

<header class="site-header">
  <div class="site-header__bar wrap">
    <a class="site-logo" href={hrefPath('/')}>
      <img
        class="site-logo__mark"
        src={hrefPath(SITE_LOGO_SRC)}
        width="160"
        height="48"
        alt={SITE_LOGO_ALT}
        decoding="async"
      />
      <span class="site-logo__tagline">{SITE_TAGLINE}</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        <li><a href={hrefPath('/')}>Home</a></li>
        <li><a href={hrefPath('/articles/')}>Stories</a></li>
        <li><a href={hrefPath('/topics/')}>Topics</a></li>
        <li><a href={hrefPath('/archive/')}>Archive</a></li>
        <li><a href={hrefPath('/about/')}>About</a></li>
        <li><a href={hrefPath('/search/')}>Search</a></li>
      </ul>
    </nav>
  </div>
</header>
