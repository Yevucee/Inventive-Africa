---
import type { CollectionEntry } from 'astro:content';
import { displayAuthor, featuredImageSrc } from '../lib/posts';
import { formatDateShort, hrefPath, postUrl } from '../lib/postPaths';
import { categorySlug, formatCategoryLabel, visibleCategoryLabels } from '../lib/taxonomy';
import { formatReadingTime } from '../lib/readingTime';
import MediaImage from './MediaImage.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  readingMinutes?: number;
}

const { post, readingMinutes } = Astro.props;
const image = featuredImageSrc(post);
const topics = visibleCategoryLabels(post.data.categories).slice(0, 2);
const readLabel = readingMinutes ? formatReadingTime(readingMinutes) : null;
---

<article class="lead-story" aria-labelledby="lead-story-title">
  {
    image ? (
      <a class="lead-story__media" href={hrefPath(postUrl(post))} tabindex="-1" aria-hidden="true">
        <MediaImage
          src={image}
          alt={post.data.featuredImageAlt || post.data.title}
          fit="contain"
          priority={true}
          class="lead-story__image"
        />
      </a>
    ) : null
  }
  <div class="lead-story__panel">
    <p class="eyebrow eyebrow--lead">Featured</p>
    {
      topics.length ? (
        <p class="lead-story__topics">
          {topics.map((category) => (
            <a class="topic-link" href={hrefPath(`/topic/${categorySlug(category)}/`)}>
              {formatCategoryLabel(category)}
            </a>
          ))}
        </p>
      ) : null
    }
    <h2 id="lead-story-title" class="lead-story__title">
      <a href={hrefPath(postUrl(post))}>{post.data.title}</a>
    </h2>
    {post.data.description ? <p class="lead-story__dek">{post.data.description}</p> : null}
    <p class="story-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDateShort(post.data.pubDate)}</time>
      {readLabel ? (
        <>
          <span aria-hidden="true">·</span>
          <span>{readLabel}</span>
        </>
      ) : null}
      <span aria-hidden="true">·</span>
      <span>{displayAuthor(post.data.author)}</span>
    </p>
  </div>
</article>
