---
import type { CollectionEntry } from 'astro:content';
import { displayAuthor, featuredImageSrc } from '../lib/posts';
import { formatDateShort, hrefPath, postUrl } from '../lib/postPaths';
import { categorySlug, formatCategoryLabel, visibleCategoryLabels } from '../lib/taxonomy';
import MediaImage from './MediaImage.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  variant?: 'feature' | 'compact' | 'list';
  headingLevel?: 'h2' | 'h3';
  hideImage?: boolean;
}

const { post, variant = 'list', headingLevel = 'h2', hideImage = false } = Astro.props;
const Tag = headingLevel;
const image = featuredImageSrc(post);
const showImage = !hideImage && image;
const topics = visibleCategoryLabels(post.data.categories).slice(0, 2);
const imageFit = variant === 'list' ? 'cover' : 'cover';
---

<article class:list={['story-card', `story-card--${variant}`]}>
  {
    showImage ? (
      <a class="story-card__media" href={hrefPath(postUrl(post))} tabindex="-1" aria-hidden="true">
        <MediaImage
          src={image!}
          alt={post.data.featuredImageAlt || post.data.title}
          fit={imageFit}
          priority={false}
        />
      </a>
    ) : null
  }
  <div class="story-card__body">
    {
      topics.length ? (
        <p class="story-card__topics">
          {topics.map((category) => (
            <a class="topic-link" href={hrefPath(`/topic/${categorySlug(category)}/`)}>
              {formatCategoryLabel(category)}
            </a>
          ))}
        </p>
      ) : null
    }
    <Tag class="story-card__title">
      <a href={hrefPath(postUrl(post))}>{post.data.title}</a>
    </Tag>
    {post.data.description ? <p class="story-card__dek">{post.data.description}</p> : null}
    <p class="story-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDateShort(post.data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{displayAuthor(post.data.author)}</span>
    </p>
  </div>
</article>
