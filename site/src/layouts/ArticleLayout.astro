---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MarkdownImage from '../components/MarkdownImage.astro';
import MediaImage from '../components/MediaImage.astro';
import ShareBar from '../components/ShareBar.astro';
import StoryCard from '../components/StoryCard.astro';
import { displayAuthor, relatedPosts } from '../lib/posts';
import { absolutePostUrl, formatDate, hrefPath, postUrl } from '../lib/postPaths';
import { categorySlug, formatCategoryLabel, visibleCategoryLabels } from '../lib/taxonomy';
import { getCollection, render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const allPosts = await getCollection('posts');
const related = relatedPosts(entry, allPosts, 4);
const { Content } = await render(entry, {
  components: {
    img: MarkdownImage,
  },
});

const siteOrigin = Astro.site ?? 'https://inventiveafrica.com';
const canonical = absolutePostUrl(siteOrigin, entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.featuredImage ? new URL(hrefPath(entry.data.featuredImage), siteOrigin).href : undefined}
  canonicalUrl={canonical}
  mainClass="article-shell"
>
  <article class="article">
    <header class="article__header">
      {
        visibleCategoryLabels(entry.data.categories).length ? (
          <p class="article__topics">
            {visibleCategoryLabels(entry.data.categories).map((category) => (
              <a class="topic-link" href={hrefPath(`/topic/${categorySlug(category)}/`)}>
                {formatCategoryLabel(category)}
              </a>
            ))}
          </p>
        ) : null
      }
      <h1>{entry.data.title}</h1>
      {entry.data.description ? <p class="article__dek">{entry.data.description}</p> : null}
      <p class="article__meta">
        Published{' '}
        <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{displayAuthor(entry.data.author)}</span>
      </p>
      {
        entry.data.updatedDate &&
        entry.data.updatedDate.getTime() !== entry.data.pubDate.getTime() ? (
          <p class="article__meta article__meta--subtle">
            Updated{' '}
            <time datetime={entry.data.updatedDate.toISOString()}>
              {formatDate(entry.data.updatedDate)}
            </time>
          </p>
        ) : null
      }
    </header>

    {
      entry.data.featuredImage ? (
        <div class="article__hero-media">
          <MediaImage
            src={entry.data.featuredImage}
            alt={entry.data.featuredImageAlt || entry.data.title}
            fit="contain"
            priority={true}
            class="article__hero-image"
          />
        </div>
      ) : null
    }

    <div class="article__body prose">
      <Content />
    </div>

    {
      entry.data.tags.length ? (
        <footer class="article__tags">
          <h2 class="section-label">Tags</h2>
          <ul>
            {entry.data.tags.map((tag) => (
              <li>
                <span class="topic-pill topic-pill--quiet">{tag}</span>
              </li>
            ))}
          </ul>
        </footer>
      ) : null
    }

    <ShareBar post={entry} siteOrigin={typeof siteOrigin === 'string' ? siteOrigin : siteOrigin.href} />

    {
      related.length ? (
        <section class="related" aria-labelledby="related-heading">
          <h2 id="related-heading" class="section-label">Related stories</h2>
          <div class="related__grid">
            {related.map((post) => (
              <StoryCard post={post} variant="feature" headingLevel="h3" />
            ))}
          </div>
        </section>
      ) : null
    }
  </article>
</BaseLayout>
