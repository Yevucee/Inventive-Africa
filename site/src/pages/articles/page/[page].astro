---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import StoryCard from '../../../components/StoryCard.astro';
import { sortPostsNewestFirst } from '../../../lib/posts';
import { archivePageUrl, paginate } from '../../../lib/pagination';

export async function getStaticPaths() {
  const posts = sortPostsNewestFirst(await getCollection('posts'));
  const { totalPages } = paginate(posts, 1);
  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const pageNumber = Number(Astro.params.page);
const posts = sortPostsNewestFirst(await getCollection('posts'));
const { items, currentPage, totalPages } = paginate(posts, pageNumber);
---

<BaseLayout
  title={`Article archive · Page ${currentPage}`}
  description="Browse the Inventive Africa article archive."
  mainClass="archive-page"
>
  <header class="page-header">
    <h1>Article archive</h1>
    <p class="lede">Page {currentPage} of {totalPages}</p>
  </header>
  <div class="archive-list">
    {items.map((post) => (
      <StoryCard post={post} variant="list" headingLevel="h2" />
    ))}
  </div>
  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    makeHref={archivePageUrl}
    label="Article archive pages"
  />
</BaseLayout>
