---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import StoryCard from '../components/StoryCard.astro';
import {
  HOMEPAGE_RECENT_COUNT,
  HOMEPAGE_SECONDARY_FEATURED,
  hasFeaturedImage,
  sortPostsNewestFirst,
  getCategoryIndex,
} from '../lib/posts';
import { formatCategoryLabel } from '../lib/taxonomy';
import { hrefPath } from '../lib/postPaths';

const allPosts = sortPostsNewestFirst(await getCollection('posts'));
const hero = allPosts.find((post) => hasFeaturedImage(post)) ?? allPosts[0];
const secondaryPool = allPosts.filter((post) => post.id !== hero?.id && hasFeaturedImage(post));
const secondaryFeatured = secondaryPool.slice(0, HOMEPAGE_SECONDARY_FEATURED);
const secondaryIds = new Set(secondaryFeatured.map((p) => p.id));
const archiveHighlights = allPosts
  .filter((post) => post.id !== hero?.id && !secondaryIds.has(post.id))
  .slice(0, HOMEPAGE_RECENT_COUNT);

const topics = getCategoryIndex(allPosts);
const spotlightTopics = topics.slice(0, 6);
---

<BaseLayout
  title="Inventive Africa"
  description="African innovation, technology, and inspiration — change is happening now."
  mainClass="home-page"
>
  {hero ? <LeadStory post={hero} /> : null}

  {
    secondaryFeatured.length ? (
      <section class="home-section" aria-labelledby="featured-heading">
        <header class="section-heading">
          <h2 id="featured-heading">Featured stories</h2>
          <p class="section-heading__hint">Hand-picked from the archive — worth your time right now.</p>
        </header>
        <div class="home-feature-grid">
          {secondaryFeatured.map((post) => (
            <StoryCard post={post} variant="feature" headingLevel="h3" />
          ))}
        </div>
      </section>
    ) : null
  }

  {
    spotlightTopics.length ? (
      <section class="home-section" aria-labelledby="topics-heading">
        <header class="section-heading">
          <h2 id="topics-heading">Explore by topic</h2>
          <a class="section-heading__more" href={hrefPath('/topics/')}>All topics</a>
        </header>
        <ul class="topic-grid">
          {spotlightTopics.map((topic) => (
            <li>
              <a class="topic-card" href={hrefPath(`/topic/${topic.slug}/`)}>
                <span class="topic-card__label">{formatCategoryLabel(topic.label)}</span>
                <span class="topic-card__count">{topic.count} stories</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <section class="home-section" aria-labelledby="archive-heading">
    <header class="section-heading">
      <h2 id="archive-heading">More from the archive</h2>
      <a class="section-heading__more" href={hrefPath('/articles/')}>Browse all stories</a>
    </header>
    <div class="home-recent-list">
      {archiveHighlights.map((post) => (
        <StoryCard post={post} variant="list" headingLevel="h3" />
      ))}
    </div>
  </section>
</BaseLayout>
