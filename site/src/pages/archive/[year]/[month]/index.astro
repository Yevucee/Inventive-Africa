---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import StoryCard from '../../../../components/StoryCard.astro';
import { postsInYearMonth } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const keys = new Set<string>();
  for (const post of posts) {
    const d = post.data.pubDate;
    keys.add(`${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`);
  }
  return [...keys].map((key) => {
    const [year, month] = key.split('-');
    return { params: { year, month } };
  });
}

const year = Number(Astro.params.year);
const month = Number(Astro.params.month);
const posts = postsInYearMonth(await getCollection('posts'), year, month);
const heading = new Intl.DateTimeFormat('en-GB', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(Date.UTC(year, month - 1, 1)));
---

<BaseLayout title={`Archive · ${heading}`} description={`Articles published in ${heading}.`} mainClass="archive-page">
  <header class="page-header">
    <p class="eyebrow">
      <a href="/archive/">Archive</a> / <a href={`/archive/${year}/`}>{year}</a>
    </p>
    <h1>{heading}</h1>
    <p class="lede">{posts.length} article{posts.length === 1 ? '' : 's'}.</p>
  </header>
  <div class="archive-list">
    {posts.map((post) => (
      <StoryCard post={post} variant="list" headingLevel="h2" />
    ))}
  </div>
</BaseLayout>
