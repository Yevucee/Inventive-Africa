---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search Inventive Africa articles." mainClass="search-page">
  <header class="page-header">
    <h1>Search</h1>
    <p class="lede">Search titles and article text across the migrated archive.</p>
  </header>
  <form class="search-form" role="search" id="search-form">
    <label for="search-input">Search articles</label>
    <input id="search-input" name="q" type="search" autocomplete="off" spellcheck="false" />
    <button type="submit">Search</button>
  </form>
  <p class="search-status" id="search-status" aria-live="polite"></p>
  <ol class="search-results" id="search-results"></ol>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';

  type SearchRecord = {
    title: string;
    description: string;
    url: string;
    pubDate: string;
    categories: string[];
  };

  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results') as HTMLOListElement;
  const statusEl = document.getElementById('search-status') as HTMLParagraphElement;

  let fuse: Fuse<SearchRecord> | null = null;

  async function loadIndex() {
    statusEl.textContent = 'Loading search index…';
    const response = await fetch('/search-index.json');
    const records = (await response.json()) as Array<SearchRecord & { body?: string }>;
    fuse = new Fuse(records, {
      keys: [
        { name: 'title', weight: 0.45 },
        { name: 'description', weight: 0.2 },
        { name: 'body', weight: 0.25 },
        { name: 'categories', weight: 0.1 },
      ],
      threshold: 0.35,
      ignoreLocation: true,
    });
    statusEl.textContent = `Searching ${records.length} articles.`;
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      runSearch(q);
    }
  }

  function runSearch(query: string) {
    if (!fuse) return;
    const trimmed = query.trim();
    if (!trimmed) {
      resultsEl.innerHTML = '';
      statusEl.textContent = 'Enter a search term.';
      return;
    }
    const hits = fuse.search(trimmed).slice(0, 20);
    statusEl.textContent = hits.length
      ? `${hits.length} result${hits.length === 1 ? '' : 's'} for “${trimmed}”.`
      : `No results for “${trimmed}”.`;
    resultsEl.innerHTML = hits
      .map(({ item }) => {
        const date = new Date(item.pubDate).toLocaleDateString('en-GB', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          timeZone: 'UTC',
        });
        return `<li><a href="${item.url}"><span class="search-results__title">${item.title}</span><span class="search-results__meta">${date}${item.categories?.length ? ' · ' + item.categories.slice(0, 2).join(', ') : ''}</span></a></li>`;
      })
      .join('');
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const q = input.value;
    const url = new URL(window.location.href);
    url.searchParams.set('q', q);
    window.history.replaceState({}, '', url);
    runSearch(q);
  });

  input.addEventListener('input', () => {
    runSearch(input.value);
  });

  loadIndex().catch(() => {
    statusEl.textContent = 'Search is unavailable right now.';
  });
</script>
